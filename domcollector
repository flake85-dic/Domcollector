        "<b>Ииии... {m} минут и {s} секунд остается до релиза Форг-- ой то есть до следующей карты!</b>",
        "<b>Пэйдэй через {m} минут и {s} секунд.</b>"
    ]

    if now - last_case < COOLDOWN_SECONDS_LOCAL:
        remaining = COOLDOWN_SECONDS_LOCAL - (now - last_case)
        m, s = divmod(remaining, 60)
        bot.send_message(
            chat_id=message.chat.id,
            text=random.choice(cooldown_texts).format(m=m, s=s),
            message_thread_id=thread_id
        )
        return


    rarity = pick_rarity()


    while rarity == "Improved":
        rarity = pick_rarity()

    EVENT_CARD_IDS = {c["id"] for c in EVENT_CARDS}

    pool = [
        c for c in CARDS
        if c["id"] not in EVENT_CARD_IDS
           and c["id"] not in ARCHIVE_CARDS
           and c["rarity"] != "Improved"  # ❗ эво-редкость не попадает в обычный дроп
    ]

    candidates = [c for c in pool if c["rarity"] == rarity]

    if candidates:
        card = random.choice(candidates)
    else:
        card = random.choice(pool)

    rarity = card["rarity"]

    exclusive_degrees = {
        "Эксклюзивная I степени",
        "Эксклюзивная II степени",
        "Эксклюзивная III степени",
    }

    # --- ГАРАНТ НОВОЙ КАРТЫ ---

            lines.append(f'<a href="{url}">{name}</a> — {qty} шт (ID: {cid})')
        else:
            lines.append(f"{name} — {qty} шт (ID: {cid})")

    chunk_and_send(message.chat.id, _thread_id_of(message), lines, chunk_size=100)



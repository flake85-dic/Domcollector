    data = load_data()
    u = get_or_init_user(data, user)

    last_case = data.get("last_case", {}).get(user_id, 0)
    now = int(time.time())
    COOLDOWN_SECONDS_LOCAL = 7200


    if user.username:
        user_display = f"@{user.username}"
    else:
        user_display = f'<a href="tg://user?id={user.id}">{user.first_name}</a>'

    cooldown_texts = [
        "<b>It's not the time... for now. Подожди еще {m} минут и {s} секунд.</b>",
        "<b>Представь забавную картинку с кроликом показывающим на часы на которых видно что до следующей карты тебе ждать еще {m} минут и {s} секунд.</b>",

def get_or_init_user(data, user):
    uid = str(user.id)
    users = data.setdefault("users", {})
    u = users.get(uid)
    if not u:
        u = {
            "id": user.id,
            "name": display_name(user),
            "username": user.username,
            "counts": {r: 0 for r in RARITY_WEIGHTS.keys()},
            "total": 0,
            "score": 0,
            "updated_at": int(time.time()),
            "cards": {},
            "unique": 0,
            "repeat_streak": 0,
        }
        users[uid] = u

    u.setdefault("cards", {})
    u.setdefault("unique", 0)
    u.setdefault("counts", {})
    u.setdefault("repeat_streak", 0)  # гарантия наличия поля
    for r in RARITY_WEIGHTS.keys():
        u["counts"][r] = u["counts"].get(r, 0)
    return u

